#!/bin/sh
# Same five checks as CI, run before anything leaves the machine.
#
#   setup:  git config core.hooksPath .githooks
#   bypass: git push --no-verify
set -e

if ! command -v uv >/dev/null 2>&1; then
    echo "pre-push: uv not found on PATH; skipping checks" >&2
    exit 0
fi

check() {
    label="$1"
    shift
    printf 'pre-push: %s\n' "$label"
    if ! "$@"; then
        echo "pre-push: $label FAILED - fix it, or push with --no-verify" >&2
        exit 1
    fi
}

check "format"    uv run ruff format --check .
check "lint"      uv run ruff check .
check "sql"       uv run sqlfluff lint jobs
check "tests"     uv run pytest
check "manifests" uv run pipeline validate
